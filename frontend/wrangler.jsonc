{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fund-horizon-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "routes": [
    { "pattern": "fundhorizon.website", "custom_domain": true },
    { "pattern": "www.fundhorizon.website", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://fund-horizon-api.fundhorizon.workers.dev",
    "API_INTERNAL_URL": "https://fund-horizon-api.fundhorizon.workers.dev"
  }
}

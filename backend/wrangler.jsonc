{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fund-horizon-api",
  "main": "src/entry.py",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["python_workers"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fund-horizon",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "fund-horizon-files"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "vars": {
    "FH_CORS_ORIGINS": "https://fund-horizon-web.<subdomain>.workers.dev,http://localhost:3000"
  }
}

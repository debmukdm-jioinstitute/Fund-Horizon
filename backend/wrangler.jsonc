{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fund-horizon-api",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "python_workers"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fund-horizon",
      "database_id": "50f61008-a4bf-48ee-a402-539b0816fb57"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "fund-horizon-files"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  },
  "vars": {
    "FH_CORS_ORIGINS": "https://fundhorizon.up.railway.app,https://fund-horizon-web.fundhorizon.workers.dev,http://localhost:3000"
  }
}
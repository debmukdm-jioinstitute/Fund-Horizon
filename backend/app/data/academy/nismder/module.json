 "cards": [
  {
   "id": "nismder-c1",
   "q": "Three uses of derivatives?",
   "a": [
    "Hedging.",
    "Speculation.",
    "Arbitrage."
   ]
  },
  {
   "id": "nismder-c2",
   "q": "Futures mechanics?",
   "a": [
    "Lot size and expiry.",
    "Initial plus MTM margin.",
    "Index cash settled."
   ]
  },
  {
   "id": "nismder-c3",
   "q": "Futures price rule?",
   "a": [
    "F = S(1 + rt) minus dividends.",
    "Basis converges to zero.",
    "Contango: futures above spot."
   ]
  },
  {
   "id": "nismder-c4",
   "q": "Hedge ratio?",
   "a": [
    "N = β × V ÷ (F × lot).",
    "Sell futures to hedge a long portfolio.",
    "Basis risk remains."
   ]
  },
  {
   "id": "nismder-c5",
   "q": "Price and OI reading?",
   "a": [
    "Up, up: fresh longs.",
    "Up, down: short covering.",
    "Down, up: fresh shorts; down, down: unwinding."
   ]
  },
  {
   "id": "nismder-c6",
   "q": "Call/put payoffs?",
   "a": [
    "Call buyer: unlimited gain.",
    "Put buyer: gain as price falls.",
    "Sellers: premium is the max gain."
   ]
  },
  {
   "id": "nismder-c7",
   "q": "Premium formula?",
   "a": [
    "Intrinsic + time value.",
    "OTM: time value only.",
    "Volatility up, premium up."
   ]
  },
  {
   "id": "nismder-c8",
   "q": "Black-Scholes inputs?",
   "a": [
    "Spot, strike, time.",
    "Rate, dividends.",
    "Volatility (estimated)."
   ]
  },
  {
   "id": "nismder-c9",
   "q": "Greeks in one line each?",
   "a": [
    "Delta: price.",
    "Gamma: delta change; theta: time.",
    "Vega: volatility; rho: rates."
   ]
  },
  {
   "id": "nismder-c10",
   "q": "Directional strategies?",
   "a": [
    "Protective put: insurance.",
    "Covered call: income, cap.",
    "Spreads: cheaper, capped."
   ]
  },
  {
   "id": "nismder-c11",
   "q": "Volatility strategies?",
   "a": [
    "Long straddle: big move.",
    "Strangle: cheaper, wider.",
    "Short straddle: range, unlimited risk."
   ]
  },
  {
   "id": "nismder-c12",
   "q": "Clearing flow?",
   "a": [
    "Order, match.",
    "Novation by clearing corporation.",
    "Daily MTM, final settlement."
   ]
  },
  {
   "id": "nismder-c13",
   "q": "Margin parts?",
   "a": [
    "SPAN plus exposure.",
    "Extreme loss, MTM.",
    "Premium for buyers."
   ]
  },
  {
   "id": "nismder-c14",
   "q": "Compliance basics?",
   "a": [
    "Risk disclosure and KYC.",
    "No assured returns.",
    "Tax: non-speculative business income."
   ]
  },
  {

# Comma-separated list of allowed browser origins
FH_CORS_ORIGINS=http://localhost:3000

# Database Configuration:
# Default: Local SQLite (plans.db)
# FH_DB_PATH=./plans.db
# Managed PostgreSQL (Supabase / Neon free tiers):
# Supabase Transaction Pooler (port 6543):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Neon Serverless PostgreSQL:
# DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require

# Optional RAG dataset directory override
# FH_DATA_DIR=../data/fundhorizon_mf_rag_dataset

# AI Provider API Keys (Fallback order: Groq -> Gemini -> OpenRouter -> Ollama)
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# OLLAMA_BASE_URL=http://localhost:11434

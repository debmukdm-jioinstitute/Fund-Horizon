# Fund Horizon — Internal Backoffice Environment Configuration
# Strict ₹0 Additional Spend • Fail-Closed Security

# Access & Isolation
FH_INTERNAL_ONLY=true
FH_COOKIE_SECURE=true
FH_ADMIN_OPEN=false
FH_ENABLE_DOCS=false

# Collector Loop & Concurrency Controls
FH_BACKOFFICE_COLLECTORS=true
FH_MARKET_MAX_CONCURRENCY=2

# Zero Paid AI Profile (Completely disables local model download and LiteLLM/Chroma calls)
FH_AI_ENABLED=false
FH_RAG_ENABLED=false

# Production Migration Gate (Refuses startup if Alembic migrations fail)
FH_REQUIRE_PRODUCTION_MIGRATIONS=true

# Database Connection (Persistent SQLite by default; or existing PostgreSQL connection)
# DATABASE_URL=postgresql://user:password@internal-db:5432/fund_horizon
FH_DB_PATH=/srv/data/fund_horizon.db

# Optional Free Registration Keys (Never required; system enters 'needs_key' state if omitted)
# FRED_API_KEY=your_free_fred_key_here

# Internal Routing
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://fundhorizon.internal
